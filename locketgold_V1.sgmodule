#!name=Locket Custom Edition
#!desc=Crack By lengoc | Tùy chỉnh Video & Caption cá nhân.

[General]

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com

[Script]
# 1. Tùy chỉnh Feature, Video 45s & Caption cá nhân
locket_remote = type=http-response, pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-.*, script-path=https://raw.githubusercontent.com/lengocnk2009-boop/locketgold/main/featural.js, requires-body=true, max-size=524288, timeout=60

# 2. Xóa ETag Header chống dính Cache (by lengoc)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/lengocnk2009-boop/locketgold/main/recapcha.js, timeout=60

# 3. Kích hoạt Gold & Ngày 25/02/2009 (by lengoc)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/lengocnk2009-boop/locketgold/main/stargold.js, requires-body=true, max-size=-1, timeout=60
